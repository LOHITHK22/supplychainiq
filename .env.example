# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=supplychainiq
POSTGRES_USER=sciq_admin
POSTGRES_PASSWORD=change-me-admin

# Least-privilege roles created by `python -m supplychainiq.db.migrate`
INGEST_DB_PASSWORD=change-me-ingest
MCP_DB_PASSWORD=change-me-mcp
APP_DB_PASSWORD=change-me-app

# --- Public data APIs (free keys) ---
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# https://api.census.gov/data/key_signup.html (optional under 500 queries/day)
CENSUS_API_KEY=

# --- Runtime ---
LOG_LEVEL=INFO
LOG_FORMAT=json
